<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="x500">

  <!-- ========================= -->
  <!-- Materials                 -->
  <!-- ========================= -->

  <material name="body_black">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>

  <material name="arm_gray">
    <color rgba="0.35 0.35 0.35 1.0"/>
  </material>

  <material name="prop_dark">
    <color rgba="0.02 0.02 0.02 1.0"/>
  </material>

  <!-- ========================= -->
  <!-- Base / Main Body          -->
  <!-- ========================= -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.28 0.22 0.08"/>
      </geometry>
      <material name="body_black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.28 0.22 0.08"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia
        ixx="0.03"
        ixy="0.0"
        ixz="0.0"
        iyy="0.03"
        iyz="0.0"
        izz="0.05"/>
    </inertial>

  </link>

  <!-- ========================= -->
  <!-- Front Left Arm            -->
  <!-- ========================= -->

  <link name="front_left_arm">
    <visual>
      <origin xyz="0.15 0.15 0" rpy="0 0 0.7854"/>
      <geometry>
        <box size="0.42 0.035 0.035"/>
      </geometry>
      <material name="arm_gray"/>
    </visual>
  </link>

  <joint name="front_left_arm_joint"
         type="fixed">
    <parent link="base_link"/>
    <child link="front_left_arm"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========================= -->
  <!-- Front Right Arm           -->
  <!-- ========================= -->

  <link name="front_right_arm">
    <visual>
      <origin xyz="0.15 -0.15 0" rpy="0 0 -0.7854"/>
      <geometry>
        <box size="0.42 0.035 0.035"/>
      </geometry>
      <material name="arm_gray"/>
    </visual>
  </link>

  <joint name="front_right_arm_joint"
         type="fixed">
    <parent link="base_link"/>
    <child link="front_right_arm"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========================= -->
  <!-- Rear Left Arm             -->
  <!-- ========================= -->

  <link name="rear_left_arm">
    <visual>
      <origin xyz="-0.15 0.15 0" rpy="0 0 -0.7854"/>
      <geometry>
        <box size="0.42 0.035 0.035"/>
      </geometry>
      <material name="arm_gray"/>
    </visual>
  </link>

  <joint name="rear_left_arm_joint"
         type="fixed">
    <parent link="base_link"/>
    <child link="rear_left_arm"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========================= -->
  <!-- Rear Right Arm            -->
  <!-- ========================= -->

  <link name="rear_right_arm">
    <visual>
      <origin xyz="-0.15 -0.15 0" rpy="0 0 0.7854"/>
      <geometry>
        <box size="0.42 0.035 0.035"/>
      </geometry>
      <material name="arm_gray"/>
    </visual>
  </link>

  <joint name="rear_right_arm_joint"
         type="fixed">
    <parent link="base_link"/>
    <child link="rear_right_arm"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========================= -->
  <!-- Motor / Propellers        -->
  <!-- ========================= -->

  <link name="front_left_motor">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.035"/>
      </geometry>
      <material name="body_black"/>
    </visual>
  </link>

  <joint name="front_left_motor_joint"
         type="fixed">
    <parent link="base_link"/>
    <child link="front_left_motor"/>
    <origin xyz="0.30 0.30 0" rpy="0 0 0"/>
  </joint>

  <link name="front_right_motor">
    <visual>
      <geometry>
        <cylinder radius="0.045" length="0.035"/>
      </geometry>
      <material name="body_black"/>
    </visual>
  </link>

  <joint name="front_right_motor_joint"
         type="fixed">
    <parent link="base_link"/>
    <child link="front_right_motor"/>
    <origin xyz="0.30 -0.30 0" rpy="0 0 0"/>
  </joint>

  <link name="rear_left_motor">
    <visual>
      <geometry>
        <cylinder radius="0.045" length="0.035"/>
      </geometry>
      <material name="body_black"/>
    </visual>
  </link>

  <joint name="rear_left_motor_joint"
         type="fixed">
    <parent link="base_link"/>
    <child link="rear_left_motor"/>
    <origin xyz="-0.30 0.30 0" rpy="0 0 0"/>
  </joint>

  <link name="rear_right_motor">
    <visual>
      <geometry>
        <cylinder radius="0.045" length="0.035"/>
      </geometry>
      <material name="body_black"/>
    </visual>
  </link>

  <joint name="rear_right_motor_joint"
         type="fixed">
    <parent link="base_link"/>
    <child link="rear_right_motor"/>
    <origin xyz="-0.30 -0.30 0" rpy="0 0 0"/>
  </joint>

  <!-- ========================= -->
  <!-- Propeller Visuals         -->
  <!-- ========================= -->

  <link name="front_left_propeller">
    <visual>
      <geometry>
        <cylinder radius="0.10" length="0.01"/>
      </geometry>
      <material name="prop_dark"/>
    </visual>
  </link>

  <joint name="front_left_propeller_joint"
         type="fixed">
    <parent link="base_link"/>
    <child link="front_left_propeller"/>
    <origin xyz="0.30 0.30 0.035" rpy="0 0 0"/>
  </joint>

  <link name="front_right_propeller">
    <visual>
      <geometry>
        <cylinder radius="0.10" length="0.01"/>
      </geometry>
      <material name="prop_dark"/>
    </visual>
  </link>

  <joint name="front_right_propeller_joint"
         type="fixed">
    <parent link="base_link"/>
    <child link="front_right_propeller"/>
    <origin xyz="0.30 -0.30 0.035" rpy="0 0 0"/>
  </joint>

  <link name="rear_left_propeller">
    <visual>
      <geometry>
        <cylinder radius="0.10" length="0.01"/>
      </geometry>
      <material name="prop_dark"/>
    </visual>
  </link>

  <joint name="rear_left_propeller_joint"
         type="fixed">
    <parent link="base_link"/>
    <child link="rear_left_propeller"/>
    <origin xyz="-0.30 0.30 0.035" rpy="0 0 0"/>
  </joint>

  <link name="rear_right_propeller">
    <visual>
      <geometry>
        <cylinder radius="0.10" length="0.01"/>
      </geometry>
      <material name="prop_dark"/>
    </visual>
  </link>

  <joint name="rear_right_propeller_joint"
         type="fixed">
    <parent link="base_link"/>
    <child link="rear_right_propeller"/>
    <origin xyz="-0.30 -0.30 0.035" rpy="0 0 0"/>
  </joint>

</robot>
