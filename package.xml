<?xml version="1.0"?>
<package format="3">

  <name>my_first_drone</name>

  <version>1.0.0</version>

  <description>
    ROS 2 Jazzy keyboard control for PX4 v1.17 Gazebo Harmonic X500 via MAVLink,
    with URDF/Xacro robot description.
  </description>

  <maintainer email="aizaz@localhost">Aizaz</maintainer>

  <license>Apache-2.0</license>

  <!-- ROS 2 build system -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- ROS 2 -->
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>

  <!-- Launch -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- URDF / Xacro -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <!-- MAVLink -->
  <exec_depend>python3-pymavlink</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>
